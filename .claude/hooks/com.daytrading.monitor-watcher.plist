<?xml version="1.0" encoding="UTF-8"?>
<!-- monitor_segment 外部守护 watcher launchd 配置（B6，2026-08-04）。
     作用：每 120 秒触发 monitor_watcher.py，盘中检查 monitor_segment 在跑否、没跑发 macOS 通知。
     独立于 Claude Code session（AI 停密采样/session 不在场，watcher 仍通知用户）。

     部署（手动，占位需替换）：
       1. 复制本文件到 ~/Library/LaunchAgents/com.daytrading.monitor-watcher.plist
       2. 把下方两个 <string> 的占位换成真实路径：
            /usr/bin/env python3   → 本机 python3 绝对路径（which python3）
            /Users/xhq/Documents/Projects/DayTradingAgent  → 本项目根绝对路径
       3. launchctl load ~/Library/LaunchAgents/com.daytrading.monitor-watcher.plist
       卸载：launchctl unload ~/Library/LaunchAgents/com.daytrading.monitor-watcher.plist
     盘外 watcher 自动跳过（in_trading_session 判断），周末/夜间不查、不发通知。
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.daytrading.monitor-watcher</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/xhq/Documents/Projects/DayTradingAgent/.claude/hooks/monitor_watcher.py</string>
    </array>

    <key>StartInterval</key>
    <integer>120</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/daytrading-monitor-watcher.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/daytrading-monitor-watcher.err</string>
</dict>
</plist>
