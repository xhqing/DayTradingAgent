<?xml version="1.0" encoding="UTF-8"?>
<!-- 密采样守护 watcher launchd 配置（2026-08-04 立；2026-08-10 撤销；2026-08-11 修复逻辑后恢复）。
     作用：每 10 秒触发 monitor_watcher.py，港股盘中检查密采样是否中断、中断发 macOS 通知。
     独立于 Claude Code session（AI 停密采样 / session 不在场，watcher 仍通知用户）。

     判定逻辑（2026-08-11 用户立）：按会话独立守护——只检查 tmp/monitor_sessions.txt 注册列表
     里的盯盘会话（preflight 自动注册、停盯注销），每个会话独立判定其 jsonl 停更 > 50 秒 →
     该会话中断 → 通知。仅港股盘中守护（美股时段用户休息不打扰，2026-08-11 用户立）。

     参数依据（2026-08-11 用户纠正 + 实测）：「无输出内容的时间间隔」= 采样段运行的时长
     （采样脚本跑 40s 期间 jsonl 停更、无输出），正常最少 ≈ 40s；实测段间 gap 6-25s 是
     分析时间（jsonl 活跃）、不是无输出间隔。判定阈值 50s（> 40s 正常无输出，留余量防误报）；
     检查间隔 10s → 最坏检测延迟 = 阈值 + 间隔 = 60s，恰好满足「真实中断 ≤ 60s」（用户立）。

     部署（手动）：
       1. 复制本文件到 ~/Library/LaunchAgents/com.daytrading.monitor-watcher.plist
       2. 确认下方 <string> 为本机真实路径（which python3；本项目根）
       3. launchctl load ~/Library/LaunchAgents/com.daytrading.monitor-watcher.plist
       卸载：launchctl unload ~/Library/LaunchAgents/com.daytrading.monitor-watcher.plist
     盘外 watcher 自动跳过（in_trading_session 判断），周末 / 夜间 / 午休 / 美股时段不查、不发通知。
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.daytrading.monitor-watcher</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/xhq/Documents/Projects/DayTradingAgent/.claude/hooks/monitor_watcher.py</string>
    </array>

    <key>StartInterval</key>
    <integer>10</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/daytrading-monitor-watcher.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/daytrading-monitor-watcher.err</string>
</dict>
</plist>
